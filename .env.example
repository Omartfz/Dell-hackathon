# Copy to .env and edit. Every value has a working default.

MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGO_DB=safecontext

# Local inference — planner and tier-1 triage. Must be localhost; the code refuses
# anything else.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=nemotron3-nano:30b
OLLAMA_FALLBACKS=nemotron3:30b,nemotron-3-nano-30b,qwen3.6:35b,qwen3.5:9b

STREAM_RATE_HZ=8
TIER2_MIN_AMOUNT=5000

# Tier 2 — the only egress. Left off by default; turn it on deliberately.
# The endpoint only ever receives minimize() output.
ESCALATION_ENABLED=false
ESCALATION_URL=
ESCALATION_MODEL=
ESCALATION_API_KEY=

HOST=127.0.0.1
PORT=8000
